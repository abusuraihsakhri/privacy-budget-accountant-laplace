{
  "openapi": "3.1.0",
  "info": {
    "title": "Privacy Budget Accountant Laplace — Legacy Audit API",
    "version": "3.0.0",
    "description": "Legacy threshold-based task triage API. This API does not implement a persistent differential-privacy budget accountant. The static browser calculator and Python Laplace module are separate."
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Local static Laplace demonstration",
        "responses": {
          "200": {
            "description": "HTML calculator"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health and metadata",
        "responses": {
          "200": {
            "description": "Service status"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON in-process task and audit counts",
        "responses": {
          "200": {
            "description": "Counts as JSON"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate legacy task thresholds and record in-memory audit HMAC",
        "responses": {
          "200": {
            "description": "Legacy consensus dossier"
          },
          "422": {
            "description": "Invalid input or identifier"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic supervisory mock response",
        "responses": {
          "200": {
            "description": "Mock response"
          },
          "400": {
            "description": "Rejected request"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "View process-local HMAC audit trail",
        "responses": {
          "200": {
            "description": "Chain integrity and audit metadata"
          }
        }
      }
    }
  }
}
